# Demo profile — stage values only. Sourced by scripts/demo.sh.
#
# This file is NOT the shared config. It holds no keys and overrides nothing in
# place: .env keeps MONAD_RPC / BUYER_KEY / MERCHANT_KEY, and engine defaults
# (1h TTL, 3-failure breaker) stay exactly as the correctness suite runs them.
#
# Why these numbers: the correctness suite waits out real deadlines
# (TestLockWaitRefund 68s, TestLockWaitClaim 133s) which is fine for a one-off
# proof and far too slow in front of an audience. Everything here is tuned so
# every beat — lock, absent, refund, circuit open — lands inside a held breath.

# --- Ports ---------------------------------------------------------------
DEMO_MERCHANT_ADDR="${DEMO_MERCHANT_ADDR:-:8081}"     # mock merchant
DEMO_LEASH_ADDR="${DEMO_LEASH_ADDR:-:8080}"        # sidecar proxy + dashboard/SSE
DEMO_CONTROL_ADDR="${DEMO_CONTROL_ADDR:-:8082}"      # agent pause/resume

# --- Settlement (demo only) ----------------------------------------------
# releaseDeadline: 15s, so a refund is watchable rather than a coffee break.
# On real chain this must match the contract TTL, hence both names.
DEMO_TTL="${DEMO_TTL:-15s}"
LEASH_DEFAULT_TTL="${LEASH_DEFAULT_TTL:-15}"

# Sweeper polls fast so the refund lands ~5s after the deadline, not 30s.
DEMO_SWEEP_INTERVAL="${DEMO_SWEEP_INTERVAL:-3s}"
DEMO_SWEEP_GRACE="${DEMO_SWEEP_GRACE:-2s}"

# 2 consecutive non-deliveries opens the circuit: at a 1.5s pace that is a
# visible "twice burned, cut off" beat. Production default stays 3.
DEMO_BREAKER_THRESHOLD="${DEMO_BREAKER_THRESHOLD:-2}"
DEMO_BREAKER_COOLDOWN="${DEMO_BREAKER_COOLDOWN:-20s}"

# --- Agent ---------------------------------------------------------------
DEMO_PACE="${DEMO_PACE:-1500ms}"             # one request per beat: watchable, still legible
DEMO_RETRIES="${DEMO_RETRIES:-2}"               # the compounding loss beat
DEMO_N="${DEMO_N:-0}"                     # 0 = buy until the presenter stops it
DEMO_START_MODE="${DEMO_START_MODE:-honest}"       # merchant starts well-behaved

# --- Chain ---------------------------------------------------------------
# 1 = in-memory chain, no funds, no RPC. Set to 0 to run the same rig against
# Monad testnet, which then needs MONAD_RPC and BUYER_KEY in .env.
DEMO_MOCK="${DEMO_MOCK:-1}"
DEMO_PRICE_WEI="${DEMO_PRICE_WEI:-1000000000000000}"   # 0.001 MON
DEMO_TENANT="${DEMO_TENANT:-agent-1}"
DEMO_DB="${DEMO_DB:-.demo/leash.db}"
